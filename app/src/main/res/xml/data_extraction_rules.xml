<data-extraction-rules>
    <cloud-backup>
        <!-- Scan history and the PhoneInfoga server address stay on the device only. -->
        <exclude domain="sharedpref" path="number_finder_history.xml"/>
        <exclude domain="sharedpref" path="phoneinfoga_prefs.xml"/>
    </cloud-backup>
